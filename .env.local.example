# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only key. Inject at runtime; never commit a real value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin credentials (used by create-admin.mjs)
ADMIN_EMAIL=your-admin-email@domain.com
ADMIN_PASSWORD=your-secure-password

# Cron job authentication (required by /api/cron/* routes)
# Generate a random secret (e.g. `openssl rand -hex 32`) and send it as
# `Authorization: Bearer <secret>` when triggering cron endpoints.
CRON_SECRET="your-random-secret-here"

# Cache Driver
#   memory → use node-cache (good for self-hosted single-instance)
#   redis  → use Upstash Redis (good for serverless/Vercel)
#   auto   → auto-detect: Redis if env vars present, else node-cache
CACHE_DRIVER=auto

# Upstash Redis (only needed if CACHE_DRIVER=redis or auto with Redis available)
# UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# Email Provider
#   dev     → logs to console, does not send (default)
#   resend  → uses Resend API
#   sendgrid → uses SendGrid API
EMAIL_PROVIDER=dev

# Email sender details
# EMAIL_FROM="E5 Chronicles <notifications@e5chronicles.com>"

# Resend (only needed if EMAIL_PROVIDER=resend)
# RESEND_API_KEY="re_..."

# SendGrid (only needed if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY="SG.xxxx"


# Site URL (used to build absolute links in email notifications)
NEXT_PUBLIC_SITE_URL="https://e5chronicles.com"
